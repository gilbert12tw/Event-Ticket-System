# Docker Compose project
COMPOSE_PROJECT_NAME=cets

# App
APP_PORT=8080
APP_ENV=local
AUTO_MIGRATE=false
OPS_API_ENABLED=false
DEMO_DEBUG_ENABLED=false
TOKEN_SIGNING_SECRET=local_dev_ticket_signing_secret_change_me
PROVIDER_TOKEN_SECRET=local_dev_provider_token_secret_change_me
REQUEST_TIMEOUT_MS=5000
DATABASE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
WORKER_POLL_INTERVAL_MS=1000
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_STOP_GRACE_PERIOD=45s
WORKER_MAX_ATTEMPTS=3
OUTBOX_BATCH_SIZE=100
WORKER_BATCH_SIZE=25
OUTBOX_LEASE_TTL_SECONDS=60
OUTBOX_RETRY_MAX=10
OUTBOX_BACKOFF_BASE_MS=500
OUTBOX_BACKOFF_MAX_MS=60000
WORKER_KINDS=notification,projection,compensation,export
WORKER_CONCURRENCY_NOTIFICATION=4
WORKER_CONCURRENCY_PROJECTION=2
WORKER_CONCURRENCY_COMPENSATION=1
WORKER_CONCURRENCY_EXPORT=1
NO_SHOW_THRESHOLD=1
NO_SHOW_COOLDOWN_DAYS=90
NO_SHOW_GRACE_HOURS=24
# Reporting freshness — seconds before a projection is considered stale (AC-6)
REPORT_STALE_THRESHOLD_SECONDS=60
# Reserved for future ops alerting; not used for blocking in Phase 2 (AC-6)
REPORT_UNAVAILABLE_TIMEOUT_SECONDS=180
# Report export source (PH2-45): projection (default) reads the reporting
# read model; operational restores the Phase 1 OLTP aggregation (rollback).
EXPORTS_SOURCE=projection
# Stale-projection policy for projection-sourced exports: fail (fail closed —
# export retries, then dead-letters with audit). Only fail is implemented.
EXPORTS_STALE_POLICY=fail

# Read-Model Rebuild (PH2-43) — `cets admin rebuild-projection`
# When true, only aggregate from OLTP and report counts; do not truncate/write.
REBUILD_DRY_RUN=false
# When true, spot-check up to 5 events against OLTP truth before commit; rollback on mismatch.
REBUILD_SAMPLE_VALIDATE=true

# Frontend hot reload
WEB_DEV_PORT=5173
CETS_DEV_API_TARGET=http://app:8080
CHOKIDAR_USEPOLLING=true

# PostgreSQL
POSTGRES_DB=cets
POSTGRES_USER=cets
POSTGRES_PASSWORD=cets_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cets:cets_dev_password@localhost:5432/cets

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
QUEUE_URL=redis://localhost:6379/1
RATE_LIMIT_ENABLED=false
BOOKING_RATE_LIMIT_RPS_PER_ACTOR=0
BOOKING_RATE_LIMIT_RPS_PER_EVENT=0
RATE_LIMIT_OUTAGE_MODE=degrade
BOOKING_RATE_LIMIT_HASH_SECRET=local_dev_rate_limit_hash_secret_change_me
BOOKING_PREADMISSION=off
BOOKING_CONTENTION_STRATEGY=phase1
REDIS_OUTAGE_MODE=degrade
RESERVATION_TTL_SECONDS=20
RESERVATION_TTL_GRACE_SECONDS=10
REDIS_OPERATION_TIMEOUT_MS=150
BOOKING_RESERVATION_HASH_SECRET=local_dev_reservation_hash_secret_change_me

# MinIO / S3-compatible object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cets-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin_dev_password

# Mailhog / mock mailer
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_FROM=no-reply@cets.local
MAILER_REDIRECT_TO=notifications@cets.local

# Optional observability profile
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
BLACKBOX_EXPORTER_PORT=9115
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=cets-api
OTEL_SERVICE_VERSION=local-compose
CETS_REPLICA_ID=app
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Phase 3 local Compose HA simulation
PHASE3_EDGE_PORT=18080
PHASE3_POSTGRES_PORT=15432
PHASE3_REDIS_PORT=16379
PHASE3_MINIO_API_PORT=19000
PHASE3_MINIO_CONSOLE_PORT=19001
PHASE3_MAILHOG_SMTP_PORT=11025
PHASE3_MAILHOG_UI_PORT=18025
LOKI_PORT=3100
TEMPO_PORT=3200
PYROSCOPE_PORT=4040
ALLOY_PORT=12345
