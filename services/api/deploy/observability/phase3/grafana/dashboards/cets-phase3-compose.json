{
  "schemaVersion": 41,
  "uid": "cets-phase3-compose",
  "title": "CETS Phase 3 Compose HA",
  "tags": ["cets", "phase3", "compose-ha", "lgtm"],
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      { "allValue": ".*", "current": { "selected": false, "text": "All", "value": ".*" }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "definition": "label_values(cets_build_info, service)", "includeAll": true, "label": "service", "multi": false, "name": "service", "query": "label_values(cets_build_info, service)", "refresh": 1, "sort": 1, "type": "query" },
      { "allValue": ".*", "current": { "selected": false, "text": "All", "value": ".*" }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "definition": "label_values(cets_build_info{service=~\"$service\"}, replica)", "includeAll": true, "label": "replica", "multi": false, "name": "replica", "query": "label_values(cets_build_info{service=~\"$service\"}, replica)", "refresh": 2, "sort": 1, "type": "query" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "RED Rate by Service and Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (service, route) (rate(cets_http_requests_total[1m]))", "legendFormat": "{{service}} {{route}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "RED 5xx Error Ratio by Service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (service) (rate(cets_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum by (service) (rate(cets_http_requests_total[5m])), 0.001)", "legendFormat": "{{service}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "title": "RED Duration Quantiles by Service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p50 {{service}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p95 {{service}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p99 {{service}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "title": "Backend Targets",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "up{job=\"cets-backend\"}", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 }
    },
    {
      "id": 10,
      "title": "Backend RED by Replica",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (service, replica, route, status) (rate(cets_http_requests_total{service=~\"$service\",replica=~\"$replica\"}[1m]))", "legendFormat": "{{service}} {{replica}} {{route}} {{status}}" },
        { "expr": "sum by (service, replica, route, status) (rate(cets_http_requests_total{service=~\"$service\",replica=~\"$replica\",status_class=\"5xx\"}[1m]))", "legendFormat": "5xx {{service}} {{replica}} {{route}} {{status}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 }
    },
    {
      "id": 15,
      "title": "RED Status Codes Last 5m",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (service, route, status) (increase(cets_http_requests_total[5m]))", "format": "table", "instant": true, "legendFormat": "{{service}} {{route}} {{status}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 }
    },
    {
      "id": 16,
      "title": "Drilldown Latency by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, route) (rate(cets_http_request_seconds_bucket{service=~\"$service\",replica=~\"$replica\"}[5m])))", "legendFormat": "p50 {{route}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cets_http_request_seconds_bucket{service=~\"$service\",replica=~\"$replica\"}[5m])))", "legendFormat": "p95 {{route}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
    },
    {
      "id": 5,
      "title": "Outbox Oldest Lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "cets_outbox_oldest_lag_seconds", "legendFormat": "{{worker_kind}} {{event_type}} {{status}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }
    },
    {
      "id": 6,
      "title": "Service Graph Edges",
      "type": "nodeGraph",
      "datasource": { "type": "tempo", "uid": "Tempo" },
      "targets": [
        { "queryType": "serviceMap" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 22 }
    },
    {
      "id": 7,
      "title": "Service Graph Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (client, server) (rate(traces_service_graph_request_total[5m]))", "legendFormat": "{{client}} -> {{server}}" },
        { "expr": "sum by (service_name, span_name) (rate(traces_spanmetrics_calls_total[5m]))", "legendFormat": "{{service_name}} {{span_name}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 }
    },
    {
      "id": 8,
      "title": "Trace-Correlated Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{service_name=~\"backend-.*|worker-.*|edge-lb|gateway-.*|frontend-lb|backend-lb\"} |= \"otel_trace_id\"" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 }
    },
    {
      "id": 11,
      "title": "Booking Stage P95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (stage, outcome, le) (rate(cets_booking_stage_seconds_bucket[5m])))", "legendFormat": "{{stage}} {{outcome}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 }
    },
    {
      "id": 12,
      "title": "Reservation Outcomes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (outcome, capacity_type, outage_mode) (rate(cets_reservation_attempt_total[5m]))", "legendFormat": "{{outcome}} {{capacity_type}} {{outage_mode}}" },
        { "expr": "histogram_quantile(0.95, sum by (outcome, capacity_type, outage_mode, le) (rate(cets_booking_preadmission_seconds_bucket[5m])))", "legendFormat": "p95 {{outcome}} {{capacity_type}} {{outage_mode}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 }
    },
    {
      "id": 13,
      "title": "DB Pool Wait Rate by Backend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (instance) (rate(cets_db_pool_acquire_wait_seconds_total{job=\"cets-backend\"}[5m]))", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 }
    },
    {
      "id": 14,
      "title": "Global DB Lock Waiting Sessions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "label_replace(max by (job) (cets_db_lock_waiting_sessions{job=\"cets-backend\"}), \"instance\", \"global-postgres\", \"job\", \".*\")", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 }
    },
    {
      "id": 9,
      "title": "CPU Profile Timeline",
      "type": "timeseries",
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "Pyroscope" },
      "targets": [
        { "labelSelector": "{service_name=~\"cets-.*\"}", "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds", "queryType": "metrics", "legendFormat": "{{service_name}}" }
      ],
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 45 }
    },
    {
      "id": 15,
      "title": "CPU Flamegraph",
      "description": "Interactive CPU flamegraph. Click a bar to zoom into that call subtree. Use the search box to filter by function name.",
      "type": "flamegraph",
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "Pyroscope" },
      "targets": [
        { "labelSelector": "{service_name=~\"cets-.*\"}", "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds", "queryType": "profile" }
      ],
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 51 }
    },
    {
      "id": 16,
      "title": "Memory Allocation Flamegraph",
      "description": "Interactive memory allocation flamegraph showing which functions allocate the most heap memory.",
      "type": "flamegraph",
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "Pyroscope" },
      "targets": [
        { "labelSelector": "{service_name=~\"cets-.*\"}", "profileTypeId": "memory:alloc_space:bytes:space:bytes", "queryType": "profile" }
      ],
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 67 }
    }
  ]
}
