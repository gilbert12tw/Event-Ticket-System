{
  "schemaVersion": 41,
  "uid": "cets-phase3-compose",
  "title": "CETS Phase 3 Compose HA",
  "tags": ["cets", "phase3", "compose-ha", "lgtm"],
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Rate by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (route, method) (rate(cets_http_requests_total[1m]))", "legendFormat": "{{method}} {{route}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "HTTP Error Ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(cets_http_requests_total{status_class=~\"4xx|5xx\"}[1m])) / sum(rate(cets_http_requests_total[1m]))", "legendFormat": "errors" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "title": "HTTP P99 Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, route, method) (rate(cets_http_request_seconds_bucket[1m])))", "legendFormat": "p99 {{method}} {{route}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "title": "Backend Targets",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "up{job=\"cets-backend\"}", "legendFormat": "{{instance}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 }
    },
    {
      "id": 10,
      "title": "Backend RED by Replica",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (instance, status_class) (rate(cets_http_requests_total[1m]))", "legendFormat": "{{instance}} {{status_class}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 }
    },
    {
      "id": 5,
      "title": "Outbox Oldest Lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "cets_outbox_oldest_lag_seconds", "legendFormat": "{{worker_kind}} {{event_type}} {{status}}" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 }
    },
    {
      "id": 6,
      "title": "Service Graph Edges",
      "type": "nodeGraph",
      "datasource": { "type": "tempo", "uid": "Tempo" },
      "targets": [
        { "queryType": "serviceMap" }
      ],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 }
    },
    {
      "id": 7,
      "title": "Service Graph Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (client, server) (rate(traces_service_graph_request_total[5m]))", "legendFormat": "{{client}} -> {{server}}" },
        { "expr": "sum by (service_name, span_name) (rate(traces_spanmetrics_calls_total[5m]))", "legendFormat": "{{service_name}} {{span_name}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 }
    },
    {
      "id": 11,
      "title": "Booking Stage P95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (stage, outcome, le) (rate(cets_booking_stage_seconds_bucket[5m])))", "legendFormat": "{{stage}} {{outcome}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 }
    },
    {
      "id": 12,
      "title": "Reservation Outcomes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (outcome, capacity_type, outage_mode) (rate(cets_reservation_attempt_total[5m]))", "legendFormat": "{{outcome}} {{capacity_type}} {{outage_mode}}" },
        { "expr": "histogram_quantile(0.95, sum by (outcome, capacity_type, outage_mode, le) (rate(cets_booking_preadmission_seconds_bucket[5m])))", "legendFormat": "p95 {{outcome}} {{capacity_type}} {{outage_mode}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 }
    },
    {
      "id": 8,
      "title": "Trace-Correlated Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{service_name=~\"backend-.*|worker-.*\"} |= \"otel_trace_id\"" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 }
    },
    {
      "id": 9,
      "title": "Profiles Available",
      "type": "timeseries",
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "Pyroscope" },
      "targets": [
        { "labelSelector": "{service_name=~\"cets-.*\"}", "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds" }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 }
    }
  ]
}
