{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "sum by (service, route) (rate(cets_http_requests_total[1m]))", "legendFormat": "{{service}} {{route}}" }
      ],
      "title": "RED Rate by Service and Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "(sum by (service) (rate(cets_http_requests_total{status_class=\"5xx\"}[5m])) or 0 * group by (service) (cets_build_info)) / clamp_min(sum by (service) (rate(cets_http_requests_total[5m])), 0.001)", "legendFormat": "{{service}}" }
      ],
      "title": "RED 5xx Error Ratio by Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p50 {{service}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p95 {{service}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p99 {{service}}" }
      ],
      "title": "RED Duration Quantiles by Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "sum by (service, route, status) (increase(cets_http_requests_total[5m]))", "format": "table", "instant": true, "legendFormat": "{{service}} {{route}} {{status}}" }
      ],
      "title": "RED Status Codes Last 5m",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "targets": [
        { "expr": "sum by (route, status) (rate(cets_http_requests_total{service=~\"$service\",replica=~\"$replica\"}[1m]))", "legendFormat": "{{route}} {{status}}" }
      ],
      "title": "Drilldown Traffic by Route and Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "targets": [
        { "expr": "sum by (service, replica, route, status) (rate(cets_http_requests_total{service=~\"$service\",replica=~\"$replica\",status_class=\"5xx\"}[1m]))", "legendFormat": "{{service}} {{replica}} {{route}} {{status}}" }
      ],
      "title": "Drilldown 5xx Rate by Replica",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, route) (rate(cets_http_request_seconds_bucket{service=~\"$service\",replica=~\"$replica\"}[5m])))", "legendFormat": "p50 {{route}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cets_http_request_seconds_bucket{service=~\"$service\",replica=~\"$replica\"}[5m])))", "legendFormat": "p95 {{route}}" }
      ],
      "title": "Drilldown Latency by Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "targets": [
        { "expr": "cets_db_pool_conns", "legendFormat": "{{state}}" },
        { "expr": "cets_db_lock_waiting_sessions", "legendFormat": "lock waits" }
      ],
      "title": "DB Pool Connections and Lock Waits",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "targets": [
        { "expr": "cets_outbox_oldest_lag_seconds", "legendFormat": "{{event_type}} {{status}}" }
      ],
      "title": "Outbox Oldest Lag",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
