{
  "name": "cets-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "e2e": "pnpm run test:e2e:mock",
    "test:e2e": "pnpm run test:e2e:mock",
    "test:e2e:mock": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
