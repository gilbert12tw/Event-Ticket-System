# Copy to infra/k8s/baremetal/.env.baremetal.local and fill real values.
# Never commit .env.baremetal.local.

# SSH / sudo
BAREMETAL_SSH_USER=user
BAREMETAL_BECOME_PASSWORD=

# Nodes
BAREMETAL_NODE_1=work1
BAREMETAL_NODE_1_IP=10.121.124.200
BAREMETAL_NODE_2=work2
BAREMETAL_NODE_2_IP=10.121.124.201
BAREMETAL_NODE_3=work3
BAREMETAL_NODE_3_IP=10.121.124.202

# Kubernetes
K8S_VERSION=1.35
CONTAINERD_IO_VERSION=1.7.29-1~ubuntu.24.04~noble
K8S_POD_CIDR=192.168.0.0/16
K8S_SERVICE_CIDR=10.96.0.0/12
K8S_API_VIP=10.121.124.210
K8S_API_PORT=6443
K8S_INTERFACE=enp6s18

# Bare-metal LoadBalancer
METALLB_LB_POOL=10.121.124.211-10.121.124.220
METALLB_INGRESS_IP=10.121.124.211
METALLB_PEER_ADDRESS=10.121.124.254
METALLB_MY_ASN=64512
METALLB_PEER_ASN=64513
METALLB_BGP_HOLD_TIME=90s

# Event Ticket System images. These must point to a registry reachable by all nodes.
CETS_NAMESPACE=cets
CETS_IMAGE_TAG=
CETS_API_IMAGE_REPOSITORY=cets-api
CETS_FRONTEND_IMAGE_REPOSITORY=cets-frontend
CETS_API_IMAGE=
CETS_FRONTEND_IMAGE=
CETS_PUSH_IMAGES=false
CETS_IMAGE_PULL_SECRET=
CETS_APP_ENV=baremetal
CETS_PUBLIC_HOSTNAME=tickets.example.com
GRAFANA_PUBLIC_HOSTNAME=

# GHCR pull credentials for Argo CD managed workloads. Use a token with read:packages.
GHCR_USERNAME=
GHCR_TOKEN=

# App secrets and runtime values.
POSTGRES_DB=cets
POSTGRES_USER=cets
POSTGRES_PASSWORD=
DATABASE_POOL_MAX_CONNS=8
TOKEN_SIGNING_SECRET=
PROVIDER_TOKEN_SECRET=
BOOKING_RESERVATION_HASH_SECRET=
OBJECT_STORAGE_BUCKET=cets-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=
MAILER_FROM=no-reply@cets.local
MAILER_REDIRECT_TO=

# Cloudflare. Domain must be active in Cloudflare before apply.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=example.com
CLOUDFLARE_TUNNEL_NAME=cets-baremetal
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ACCESS_ENABLED=true
CLOUDFLARE_ACCESS_ALLOWED_EMAILS=
CLOUDFLARE_ACCESS_DEVICE_POSTURE_RULE_IDS=
