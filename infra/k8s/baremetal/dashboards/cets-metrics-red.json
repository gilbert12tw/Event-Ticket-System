{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "sum by (service, route) (rate(cets_http_requests_total[1m]))", "legendFormat": "{{service}} {{route}}", "refId": "A" }
      ],
      "title": "RED Rate by Service and Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "sum by (service) (rate(cets_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum by (service) (rate(cets_http_requests_total[5m])), 0.001)", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "RED 5xx Error Ratio by Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p50 {{service}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p95 {{service}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, service) (rate(cets_http_request_seconds_bucket[5m])))", "legendFormat": "p99 {{service}}", "refId": "C" }
      ],
      "title": "RED Duration Quantiles by Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "id": 4,
      "targets": [
        { "expr": "sum by (service, route, status) (increase(cets_http_requests_total[5m]))", "format": "table", "instant": true, "legendFormat": "{{service}} {{route}} {{status}}", "refId": "A" }
      ],
      "title": "RED Status Codes Last 5m",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "id": 5,
      "targets": [
        { "expr": "sum by (route, status) (rate(cets_http_requests_total{service=~\"$service\",replica=~\"$replica\"}[1m]))", "legendFormat": "{{route}} {{status}}", "refId": "A" }
      ],
      "title": "Drilldown Traffic by Route and Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "id": 6,
      "targets": [
        { "expr": "sum by (service, replica, route, status) (rate(cets_http_requests_total{service=~\"$service\",replica=~\"$replica\",status_class=\"5xx\"}[1m]))", "legendFormat": "{{service}} {{replica}} {{route}} {{status}}", "refId": "A" }
      ],
      "title": "Drilldown 5xx Rate by Replica",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, route) (rate(cets_http_request_seconds_bucket{service=~\"$service\",replica=~\"$replica\"}[5m])))", "legendFormat": "p50 {{route}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cets_http_request_seconds_bucket{service=~\"$service\",replica=~\"$replica\"}[5m])))", "legendFormat": "p95 {{route}}", "refId": "B" }
      ],
      "title": "Drilldown Latency by Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "targets": [
        { "expr": "cets_build_info", "format": "table", "instant": true, "legendFormat": "{{service}} {{replica}}", "refId": "A" }
      ],
      "title": "Observed Service Replicas",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["cets", "k8s", "metrics", "red"],
  "templating": {
