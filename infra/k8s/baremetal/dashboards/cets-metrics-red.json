      { "allValue": ".*", "current": { "selected": false, "text": "All", "value": ".*" }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "definition": "label_values(cets_build_info{service=~\"$service\"}, replica)", "includeAll": true, "label": "replica", "multi": false, "name": "replica", "query": "label_values(cets_build_info{service=~\"$service\"}, replica)", "refresh": 2, "sort": 1, "type": "query" }
    ]
  },
