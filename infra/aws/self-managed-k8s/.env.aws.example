# Copy to infra/aws/self-managed-k8s/.env.aws.local and fill real values.
# Never commit .env.aws.local.

# AWS account and region. 10-cost-plan.sh can compare the allowed regions.
AWS_REGION=us-west-2
AWS_ALLOWED_REGIONS=us-west-2,us-east-2,us-east-1
AWS_ACCOUNT_ID=
AWS_STACK_PREFIX=cets-aws-k8s

# Capacity profile. NODE_COUNT must be 1 or 3; 2 is intentionally rejected.
# The default paid profile is stable multi-node On-Demand capacity that fits the
# two-week 190 USD guardrail estimate. Use Spot only for explicitly accepted
# interruption risk or larger short-lived nodes.
NODE_COUNT=3
CONTROL_PLANE_INSTANCE_TYPE=r6a.large
FALLBACK_INSTANCE_TYPE_1=r5a.large
FALLBACK_INSTANCE_TYPE_2=r6i.large
PURCHASE_OPTION=OnDemand
ROOT_VOLUME_GB=120
WORKER_MAX_CAPACITY=0

# Budget guardrails. Runtime default is 14 days.
BUDGET_LIMIT_USD=190
COST_RESERVE_USD=15
MAX_RUNTIME_HOURS=336
# VM running hours within MAX_RUNTIME_HOURS. Use this with pause/resume.
ACTIVE_RUNTIME_HOURS=336
EXPIRATION_UTC=
COST_ALERT_EMAIL=
DEDICATED_AWS_ACCOUNT_ACK=false

# Access. Prefer SSM-only; SSH is optional for faster bootstrap diagnostics.
ADMIN_CIDR=0.0.0.0/32
EC2_KEY_NAME=
AWS_USE_SSM=true
AWS_SSH_USER=ubuntu
AWS_SSH_KEY_PATH=

# Ingress. Cloudflare Tunnel is the budget default. Set nlb only when needed.
APP_INGRESS_MODE=cloudflare
CLOUDFLARE_TUNNEL_TOKEN=
CETS_PUBLIC_HOSTNAME=tickets.example.com
PUBLIC_URL=

# Kubernetes and application images.
K8S_VERSION=1.35
K8S_POD_CIDR=192.168.0.0/16
K8S_SERVICE_CIDR=10.96.0.0/12
K8S_CONTAINER_LOG_MAX_SIZE=50Mi
K8S_CONTAINER_LOG_MAX_FILES=10
CETS_NAMESPACE=cets
CETS_APP_ENV=aws-self-managed-k8s
# Set true only for temporary demo deployments that need mock profile login.
ALLOW_DEMO_APP_ENV=false
# Set true only when intentionally exposing the app through a public quick HTTPS URL.
QUICK_HTTPS_PUBLIC_EXPOSURE_ACK=false
CETS_IMAGE_TAG=
CETS_API_IMAGE=
CETS_FRONTEND_IMAGE=
BUILD_AND_PUSH_IMAGES=false
FORCE_PRIVATE_IMAGE_ROLLOUT=false
# AWS x86_64 EC2 instances need linux/amd64 images; override only for arm64 nodes.
CETS_IMAGE_PLATFORM=linux/amd64
BACKEND_MAX_REPLICAS=6
FRONTEND_MAX_REPLICAS=6

# Cost pause/resume. Pause is destructive for node-local Kubernetes data.
PAUSE_WAIT=true
PAUSE_DESTROYS_NODE_LOCAL_DATA_ACK=false
RESUME_DEPLOY_APP=false
RESUME_VERIFY=true

# GitOps release control. Argo CD watches RELEASE_BRANCH; version tags are manual.
RELEASE_BRANCH=release/aws-self-managed-k8s
CETS_RELEASE_VERSION=v0.0.1
ARGOCD_APP_NAME=cets-aws-self-managed
ARGOCD_NAMESPACE=argocd
ARGOCD_PROJECT=default
ARGOCD_REPO_URL=https://github.com/gilbert12tw/Event-Ticket-System.git
ARGOCD_TARGET_REVISION=release/aws-self-managed-k8s

# Application secrets and runtime values.
POSTGRES_DB=cets
POSTGRES_USER=cets
POSTGRES_PASSWORD=
TOKEN_SIGNING_SECRET=
PROVIDER_TOKEN_SECRET=
BOOKING_RESERVATION_HASH_SECRET=
OBJECT_STORAGE_BUCKET=cets-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=
MAILER_FROM=no-reply@cets.local
MAILER_REDIRECT_TO=
