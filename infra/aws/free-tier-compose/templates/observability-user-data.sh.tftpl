#!/usr/bin/env bash
set -euo pipefail

dnf update -y
dnf install -y docker git
systemctl enable --now docker
usermod -aG docker ec2-user || true

curl -fsSL https://github.com/docker/compose/releases/download/v2.30.3/docker-compose-linux-aarch64 \
  -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose
ln -sf /usr/local/bin/docker-compose /usr/libexec/docker/cli-plugins/docker-compose

install -d -o ec2-user -g ec2-user /opt/cets
if [ ! -d /opt/cets/.git ]; then
  git clone --branch "${repository_branch}" --depth 1 "${repository_url}" /opt/cets
fi
cd /opt/cets
git fetch origin "${repository_branch}"
git reset --hard "origin/${repository_branch}"

cat >/opt/cets/services/api/deploy/.env.observability <<'ENV'
GRAFANA_ADMIN_USER=${grafana_admin_user}
GRAFANA_ADMIN_PASSWORD=${grafana_admin_password}
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
PYROSCOPE_PORT=4040
ALLOY_PORT=12345
ENV
chown ec2-user:ec2-user /opt/cets/services/api/deploy/.env.observability
chmod 0600 /opt/cets/services/api/deploy/.env.observability

cat >/opt/cets/services/api/deploy/observability/phase3/prometheus.yml <<'PROMETHEUS'
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: cets-backend
    scheme: https
    metrics_path: /metrics
    static_configs:
      - targets:
          - ${domain_name}:443
        labels:
          service: cets-backend
          phase: phase3-aws

  - job_name: tempo
    static_configs:
      - targets:
          - tempo:3200
        labels:
          service: tempo
          phase: phase3-aws

  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090
        labels:
          service: prometheus
          phase: phase3-aws
PROMETHEUS
chown ec2-user:ec2-user /opt/cets/services/api/deploy/observability/phase3/prometheus.yml
chmod 0644 /opt/cets/services/api/deploy/observability/phase3/prometheus.yml

docker compose \
  --env-file /opt/cets/services/api/deploy/.env.observability \
  -f /opt/cets/services/api/deploy/compose.yaml \
  -f /opt/cets/services/api/deploy/compose.phase3-ha.yaml \
  --profile observability \
  up -d grafana prometheus loki tempo pyroscope alloy redis mailhog
